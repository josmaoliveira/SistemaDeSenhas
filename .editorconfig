# Padrão de formatação do projeto (VS Code, IntelliJ e outros editores leem este arquivo)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,json,yml,yaml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
